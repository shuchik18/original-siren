val make_obs = fun (obs, prev_x) ->
  let x <- gaussian(prev_x, 1) in
  let () = observe(gaussian(x, 1), obs) in
  x
in

let data = List.range(1, 5) in
let x0 <- gaussian(0, 100) in

let obs1 = List.hd(data) in
let rest1 = List.tl(data) in
let x1 = fold(make_obs,obs1, x0) in


let obs4 = List.hd(rest1) in
let x4 = fold(make_obs,obs4, x1) in

let last_state = x4 in
let past_states = x1 in

(last_state, past_states)
