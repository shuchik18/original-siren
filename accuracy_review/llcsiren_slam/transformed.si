val bernoulli_priors = fun (i) -> let rv1 = Prob.new_var() in let () = Prob.set_distr(rv1,bernoulli(0.5)) in let () = Prob.set_lookup("cell",rv1) in let cell = rv1 in cell in val new_make_obs1 = fun ((obs, cmd), (max_pos, map, xs)) -> let prev_x = 0.0 in let sensor_noise = 0.1 in let wheel_noise = 0.1 in let rv5 = Prob.new_var() in let () = Prob.set_distr(rv5,bernoulli(wheel_noise)) in let () = Prob.set_lookup("wheel_slip",rv5) in let () = Prob.set_distr(rv5,bernoulli(0.1)) in let () = Prob.set_distr(rv5,bernoulli(0.1)) in let sample S7 <- Prob.get_distr(rv5) in let () = Prob.set_distr(rv5,delta(S7)) in let wheel_slip = S7 in let cmd2 = cmd in let x = if wheel_slip then prev_x else add(prev_x,cmd2) in let x = x in let c0 = List.hd(map) in let c1 = List.hd(List.tl(map)) in let o = if (x = 0.0) then c0 else c1 in let rv9 = Prob.new_var() in let () = Prob.set_distr(rv9,bernoulli(if o then sub(1.0,sensor_noise) else sensor_noise)) in let () = Prob.set_distr(rv9,bernoulli(Prob.get_p(Prob.get_distr(rv9)))) in let __siren_update_posterior_11 = bernoulli(((Prob.get_p(Prob.get_distr(Prob.get_par(rv9,0))) * Prob.subst_rv(if rv9 then Prob.get_p(Prob.get_distr(rv9)) else (1 + (sub(0,1) * Prob.get_p(Prob.get_distr(rv9)))),Prob.get_par(rv9,0),true)) / if rv9 then ((Prob.get_p(Prob.get_distr(Prob.get_par(rv9,0))) * Prob.subst_rv(Prob.get_p(Prob.get_distr(rv9)),Prob.get_par(rv9,0),true)) + (0.5 * Prob.subst_rv(Prob.get_p(Prob.get_distr(rv9)),Prob.get_par(rv9,0),false))) else (1 + (sub(0,1) * ((Prob.get_p(Prob.get_distr(Prob.get_par(rv9,0))) * Prob.subst_rv(Prob.get_p(Prob.get_distr(rv9)),Prob.get_par(rv9,0),true)) + (0.5 * Prob.subst_rv(Prob.get_p(Prob.get_distr(rv9)),Prob.get_par(rv9,0),false))))))) in let __siren_update_marginal_11 = bernoulli(((Prob.get_p(Prob.get_distr(Prob.get_par(rv9,0))) * Prob.subst_rv(Prob.get_p(Prob.get_distr(rv9)),Prob.get_par(rv9,0),true)) + (0.5 * Prob.subst_rv(Prob.get_p(Prob.get_distr(rv9)),Prob.get_par(rv9,0),false)))) in let () = Prob.set_distr(Prob.get_par(rv9,0),__siren_update_posterior_11) in let () = Prob.set_distr(rv9,__siren_update_marginal_11) in let () = Prob.set_distr(rv9,bernoulli(Prob.get_p(Prob.get_distr(rv9)))) in let () = Prob.observe_inner(rv9,obs) in let () = Prob.null() in (max_pos, (map, cons(x,xs))) in let data = cons((0.0, 1.0),cons((0.0, -1.0),lst())) in let max_pos = 1.0 in let map = [bernoulli_priors(0), bernoulli_priors(1)] in let (_, map, xs) = fold(new_make_obs1, data, (max_pos, (map, lst()))) in let xs = List.rev(xs) in Prob.finalize((map, xs))