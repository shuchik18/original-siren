+def new_make_obs1(particle, observation_command, accumulator):
+  obs, cmd = observation_command
+  max_pos, cells, xs = accumulator
+  previous = 0.0 if not xs else particle.state.value_expr(xs[0]).v
+  slip = sample(particle, bernoulli(const(0.1)))
+  target = previous + cmd.v
+  command = cmd.v if 0 <= target <= max_pos.v else 0.0
+  position = previous if truth(particle, slip) else previous + command
+  cell = cells[0 if position == 0 else 1]
+  prior = particle.state.eval_distr(get_distr(particle, cell)).p.v
+  # Condition the selected map cell on the actual observation. Both mixture
+  # terms use its current prior, including when a cell is revisited.
+  observed = bool(obs.v)
+  likelihood_true = 0.9 if observed else 0.1
+  likelihood_false = 1.0 - likelihood_true
+  evidence = prior * likelihood_true + (1.0 - prior) * likelihood_false
+  observe(particle, bernoulli(const(evidence)), const(True))
+  set_distr(particle, cell, bernoulli(const(prior * likelihood_true / evidence)))
+  return pair(max_pos, pair(cells, cons(const(position), xs)))
 
